# Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=travian_tools
MYSQL_USER=travian
MYSQL_PASSWORD=your_password

# Backend Configuration
DATABASE_URL=mysql+mysqlconnector://travian:your_password@db:3306/travian_tools
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 交給瀏覽器擴充的登入憑證有效時間（分鐘）
JWT_EXTENSION_TOKEN_EXPIRE_MINUTES=480

# Frontend Configuration
VITE_API_URL=http://localhost:8000
# 瀏覽器擴充 ID（chrome://extensions 上看得到；可用逗號分隔多個）。
# 設定後，網站登入時會把有到期時間的憑證交給擴充；留空就不交。
VITE_EXTENSION_ID=
