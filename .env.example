# Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=travian_tools
MYSQL_USER=travian
MYSQL_PASSWORD=your_password

# Backend Configuration
DATABASE_URL=mysql+mysqlconnector://travian:your_password@db:3306/travian_tools
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 必填（DEBUG=false 時）：至少 32 字元的隨機值，例如 `openssl rand -base64 48` 的結果。
# 沒設或用預設值，後端會拒絕啟動。
JWT_SECRET_KEY=
# 交給瀏覽器擴充的登入憑證有效時間（分鐘）
JWT_EXTENSION_TOKEN_EXPIRE_MINUTES=480

# Frontend Configuration
VITE_API_URL=http://localhost:8000
# 瀏覽器擴充 ID。manifest.json 有固定的 key，所以「載入未封裝項目」的 ID 一定是這個。
# 網站登入時會把有到期時間的憑證交給擴充；設成空字串就不交。可用逗號分隔多個。
VITE_EXTENSION_ID=nkgbmaokaapljaciiifbhgohlejmdcdn
