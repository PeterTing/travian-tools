{
  "manifest_version": 3,
  "name": "Travian Tools Helper",
  "version": "0.1.0",
  "description": "Sync your Travian: Legends game data with Travian Tools",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://*.travian.com/*",
    "*://*.travian.tw/*",
    "*://*.travian.net/*",
    "*://*.x1.asia.travian.com/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.travian.com/*",
        "*://*.travian.tw/*",
        "*://*.travian.net/*",
        "*://*.x1.asia.travian.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
