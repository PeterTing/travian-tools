    "clsx": "^2.1.0",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.323.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.3",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.0"
