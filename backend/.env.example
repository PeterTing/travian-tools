# Application settings
PROJECT_NAME=Travian Tools API
VERSION=0.1.0
DEBUG=true
# JWT secret：DEBUG=true 時可以省略（用內建的開發用預設值）；
# DEBUG=false 時必填、至少 32 字元（`openssl rand -base64 48`），否則後端拒絕啟動。
# JWT_SECRET_KEY=
API_V1_PREFIX=/api/v1

# Database settings
DATABASE_URL=mysql+mysqlconnector://root:password@localhost:3306/travian_tools?charset=utf8mb4

# map.sql daily fetch (public map.sql only; no credentials, no browser)
MAP_SQL_DAILY_FETCH_ENABLED=true
MAP_SQL_FETCH_HOUR_UTC=4
MAP_SQL_FETCH_MINUTE_UTC=15

# CORS settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
