# Application settings
PROJECT_NAME=Travian Tools API
VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# Database settings
DATABASE_URL=mysql+mysqlconnector://root:password@localhost:3306/travian_tools?charset=utf8mb4

# map.sql daily fetch (public map.sql only; no credentials, no browser)
MAP_SQL_DAILY_FETCH_ENABLED=false
MAP_SQL_FETCH_HOUR_UTC=4
MAP_SQL_FETCH_MINUTE_UTC=15

# CORS settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
